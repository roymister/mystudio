rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Correos con permiso de administrador (igual que ADMIN_EMAILS en src/firebase-store.js)
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['correo-eliminado', 'correo-eliminado'];
    }

    // Ajustes, categorías y carrusel: todos leen, solo administradores escriben
    match /tienda/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Productos: todos leen, solo administradores escriben
    match /productos/{id} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Todo lo demás, cerrado
    match /{otro=**} {
      allow read, write: if false;
    }
  }
}
